# Get from @BotFather (make a NEW bot for this — don't reuse Laila's token)
BOT_TOKEN=

# MongoDB connection string (e.g. from a free MongoDB Atlas cluster)
MONGO_URI=

# Your numeric Telegram user ID — get it from @userinfobot. Always has sudo.
OWNER_ID=

# Optional: comma-separated extra admin user IDs, e.g. 111111,222222
SUDO_IDS=

# Optional: the group/channel chat ID where sudo users post
# "photo + caption: Name | Anime | Rarity" to auto-add characters.
# Get the ID with any get-chat-id bot, or the /id-style command in that group.
WAIFU_SOURCE_CHAT_ID=

# Optional: only needed if deploying with a public webhook URL (e.g. on Render/Railway).
# Leave blank to run in polling mode (works anywhere, including locally).
WEBHOOK_URL=
PORT=8000
